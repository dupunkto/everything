#!/usr/bin/env bash

use php

PORT=4000
TLS_PORT=4443
ENTRYPOINT=index.php
STORE=data.db
REPO=export.git

export AUTH_PROVIDER=basic
export AUTH_PASSWORD=pannekoek

serve() {
  case ${SECURE:-true} in
    1|true|on|yes)
      spawn \
        "env ENV=dev php -S 0.0.0.0:$PORT $ENTRYPOINT" \
        "env PORT=$PORT TLS_PORT=$TLS_PORT node proxy.js"
      ;;
    *)
      ENV=dev php -S 0.0.0.0:$PORT $ENTRYPOINT
      ;;
  esac
}

deploy() {
  # The deployment on the old shared hosting uses a git clone that we need to update.
  echo 'h sys.geheimesite.nl && git pull && git submodule update' | ssh s11
}

export() {
  ./export.php enable "${1:-$REPO}"
}

clean() {
  rm -rf $STORE $REPO
}
