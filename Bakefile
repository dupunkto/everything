#!/usr/bin/env bash

PORT=4000
TLS_PORT=4443
ENTRYPOINT=index.php
STORE=data.db
REPO=export.git

export AUTH_PROVIDER=basic
export AUTH_PASSWORD=pannekoek

# Configure the PHP server to start two
# concurrent threads.
export PHP_CLI_SERVER_WORKERS=2

serve() {
  case ${SECURE:-true} in
    1|true|on|yes)
      spawn \
        "env ENV=dev php -S 0.0.0.0:$PORT $ENTRYPOINT" \
        "env PORT=$PORT TLS_PORT=$TLS_PORT node proxy.js"
      ;;
    *)
      ENV=dev php -S 0.0.0.0:$PORT $ENTRYPOINT
      ;;
  esac
}

export() {
  ./export.php enable "${1:-$REPO}"
}

clean() {
  rm -rf $STORE $REPO
}