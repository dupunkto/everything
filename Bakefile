#!/bin/bash

SRC=linio.ts
OUT=a.out

export DIST=dist
export PUBLIC=public

setup() {
  bun i
}

serve() {
  bun run --define DEV=true --define PORT=9001 --hot $SRC "${1:-.}"
}

build() {
  p:set_import dist
  bun run build.ts
  bun build --define DEV=false --define PORT=9000 --compile $SRC --outfile $OUT
  p:set_import public
}

install() {
  cp $OUT ${XDG_BINARY_HOME:-$HOME/.local/bin}/linio
}

clean() {
  rm -rf dist/*
  rm -rf $OUT
}


reinstall() {
  local ID=org.dupunkto.linio
  local plist="$HOME/Library/LaunchAgents/$ID.plist"
  local service="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/linio.service"

  # On Linux, a file being executed is marked 'busy' and cannot be modified.
  # However, on Darwin, the binary is fully in memory so can be hot-swapped.
  # No need to first stop the old service first--it keeps running and only
  # needs to be restarted.
  if has systemctl && [ -f "$service" ]; then
    systemctl --user stop linio.service
  fi

  clean
  build
  install

  if has systemctl && [ -f "$service" ]; then
    systemctl --user daemon-reload
    systemctl --user restart linio.service
  fi

  if has launchctl && [ -f "$plist" ]; then
    launchctl kickstart -k gui/$(id -u)/$ID
  fi
}

p:set_import() {
  case "$1" in
    public)
      sed -E 's|\./dist/|\./public/|' linio.ts > linio.ts.tmp && mv -f linio.ts.tmp linio.ts
      ;;
    dist)
      sed -E 's|\./public/|\./dist/|' linio.ts > linio.ts.tmp && mv -f linio.ts.tmp linio.ts
      ;;
  esac
}
